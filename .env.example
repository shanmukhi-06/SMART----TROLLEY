# ==========================================================================
# Smart Shopping Trolley - configuration
# Copy this file to `.env` and edit. All values have safe defaults.
# ==========================================================================

# --- Runtime mode -----------------------------------------------------------
# HARDWARE_MODE decides where the load cell lives:
#   simulation  laptop demo, software scale, no hardware needed
#   local       app + HX711 on the same Raspberry Pi (single-box setup)
#   cloud       app runs on AWS; pi_agent.py on the trolley streams the load
#               cell up and receives tare/calibrate commands back
#   auto        follow the legacy SIMULATION flag below
HARDWARE_MODE=auto
SIMULATION=true

# Store / branding shown on the UI and receipts
STORE_NAME=Smart Mart
STORE_TAGLINE=Scan. Pack. Walk out.

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Signs the staff settings-menu cookie. Generate: openssl rand -hex 32
# Leave blank in development; admin sessions then reset on each restart.
SECRET_KEY=
# Only needed if the kiosk page and the API are on different origins.
# Comma separated, e.g. https://trolley.example.com
CORS_ORIGINS=

# --- Database ---------------------------------------------------------------
# SQLite for local work. For AWS use RDS Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/trolley
DATABASE_URL=sqlite:///./smart_trolley.db

# --- Cloud <-> trolley device bridge (HARDWARE_MODE=cloud) ------------------
# Shared secret the Pi agent presents to the cloud. MUST be identical on both
# sides. Generate: openssl rand -hex 32
# In cloud mode an empty token means the cloud REJECTS every agent request.
DEVICE_TOKEN=
DEVICE_ID=trolley-1
# Agent side: where the cloud app lives.
CLOUD_URL=http://localhost:8000
# A load-cell reading older than this counts as "trolley offline".
DEVICE_STALE_AFTER_S=6.0
# If the trolley is offline, fall back to a software scale so the cloud app is
# still clickable. Set FALSE in production: with it on, a disconnected trolley
# silently stops doing real weight verification (the UI does flag it).
ALLOW_SIM_FALLBACK=true

# --- Load cell: 4 x 50 kg cells -> one HX711 --------------------------------
# BCM GPIO numbers (Pi 5 / lgpio). DT=data out, SCK=clock.
#   HX711 VCC -> Pi 3V3 (pin 1)   GND -> pin 6
#   HX711 DT  -> GPIO5  (pin 29)  SCK -> GPIO6 (pin 31)
# Power the HX711 from 3V3, not 5V: a 5V DOUT is out of spec for Pi inputs.
HX711_DT_PIN=5
HX711_SCK_PIN=6
# 128 gives the most resolution; drop to 64 if the cells saturate the HX711.
HX711_GAIN=128
# Calibration produced by `python calibrate_scale.py calibrate`. Once you
# calibrate from the settings menu these become fallback defaults only, because
# the values are then stored in the database.
SCALE_REFERENCE_UNIT=1.0
SCALE_OFFSET=0.0
# Anti-theft tolerance: how far measured weight may differ from expected (grams).
# The check uses max(this, 15% of the expected weight).
WEIGHT_TOLERANCE_G=25.0
# Combined rated capacity, for sanity warnings during calibration (4 x 50 kg).
SCALE_CAPACITY_G=200000
# How often the Pi agent pushes a reading, in seconds.
SCALE_STREAM_INTERVAL_S=0.25

# --- Scan feedback ----------------------------------------------------------
# No buzzer or LEDs are wired. Feedback is a colour flash plus an optional beep
# played by the browser. Set false for a silent store.
UI_BEEP=true

# --- Camera (backup scanner) -------------------------------------------------
# The USB barcode gun is the primary scanner and needs no config: it behaves as
# a keyboard and types straight into the browser.
CAMERA_ENABLED=true
CAMERA_INDEX=0

# --- Staff settings menu ----------------------------------------------------
# PIN that unlocks ⚙ Settings in the UI: product registration, product lookup
# and scale calibration. CHANGE THIS.
ADMIN_PIN=1234
ADMIN_SESSION_HOURS=8

# --- Kiosk display ----------------------------------------------------------
# Ask the browser to go fullscreen automatically on the shop screen.
KIOSK_MODE=false
# URL the Pi's browser opens. Blank falls back to CLOUD_URL.
KIOSK_URL=

# --- Payment ----------------------------------------------------------------
# PAYMENT_PROVIDER: mock | phonepe
#   mock    -> generates a demo UPI QR and auto-confirms (great for testing).
#   phonepe -> real PhonePe PG (fill the test credentials below).
PAYMENT_PROVIDER=mock
# UPI id shown on the mock QR (used only by the mock provider)
MOCK_UPI_VPA=smartmart@upi

# PhonePe PG test credentials (sandbox). Fill these when you have them.
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox
# Public URL PhonePe calls back / redirects to
PHONEPE_CALLBACK_URL=http://localhost:8000/api/payments/phonepe/callback

# --- Receipt email (SMTP) ---------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Smart Mart <noreply@smartmart.local>

# --- Receipt SMS (driver off until a provider is configured) ----------------
SMS_ENABLED=false

# --- Thermal printer (app/hardware/printer.py) -------------------------------
# auto | simulation | usb | bluetooth | network | remote
PRINTER_TRANSPORT=auto
PRINTER_PAPER_WIDTH_CHARS=48
PRINTER_CHARSET=cp437
PRINTER_AUTO_PRINT_RECEIPTS=false

# USB
PRINTER_USB_DEVICE=
PRINTER_USB_DRIVER=auto
PRINTER_USB_VENDOR=
PRINTER_USB_PRODUCT=

# Bluetooth
PRINTER_BT_ADDRESS=
PRINTER_BT_NAME=
PRINTER_BT_CHANNEL=1
PRINTER_BT_TRANSPORT=rfcomm

# Network
PRINTER_NET_HOST=
PRINTER_NET_PORT=9100
